{
  "name": "godplans",
  "version": "1.14.0",
  "private": true,
  "description": "Plan everything before anything. One command turns an idea or an existing codebase into an audit-aware, validated master plan (PLAN.mdx), from pricing and product decisions to architecture, security, and launch, that any coding agent executes checkbox by checkbox. For Claude Code, Codex, Cursor, Gemini CLI, OpenCode, and any Agent Skills client.",
  "keywords": [
    "agent-skills",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "windsurf",
    "planning",
    "project-planning",
    "master-plan",
    "plan-first",
    "spec-driven-development",
    "prd",
    "product-management",
    "architecture",
    "roadmap",
    "audit-aware",
    "security-by-design",
    "developer-tools"
  ],
  "homepage": "https://github.com/hannsxpeter/godplans",
  "bugs": "https://github.com/hannsxpeter/godplans/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hannsxpeter/godplans.git"
  },
  "license": "MIT",
  "author": "aihxp (https://github.com/hannsxpeter)",
  "files": [
    "skills",
    "install.sh",
    "scripts",
    "requirements",
    "evals/cases",
    "evals/cases-roster.txt",
    "evals/external/GRADE.schema.json",
    "evals/external/README.md",
    "evals/external/RUBRIC.md",
    "evals/metrics",
    "evals/outcomes/README.md",
    "evals/outcomes/cases",
    "evals/runners",
    "evals/README.md",
    "tests",
    "docs",
    "PROMPT.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "scripts": {
    "test": "bash tests/run.sh",
    "catalog": "node scripts/build-catalog.js",
    "catalog:check": "node scripts/build-catalog.js --check",
    "generate": "npm run catalog && npm run build:prompt && npm run metrics:context",
    "version:sync": "node scripts/version-sync.js",
    "version:check": "node scripts/version-sync.js --check",
    "release:prepare": "node scripts/release-prepare.js",
    "lint": "bash scripts/lint.sh --all --verbose",
    "check": "npm run version:check && npm run catalog:check && npm run metrics:check && npm run lint && npm test",
    "eval": "bash scripts/eval.sh",
    "eval:check": "bash scripts/eval.sh --check-cases",
    "eval:matrix": "bash scripts/eval-matrix.sh",
    "eval:external": "node scripts/eval-external.js",
    "eval:outcome": "node scripts/eval-outcome.js",
    "metrics:context": "node scripts/context-metrics.js",
    "metrics:check": "node scripts/context-metrics.js --check",
    "build:prompt": "bash scripts/build-prompt.sh",
    "release:check": "bash scripts/release-check.sh",
    "prepack": "npm run check"
  }
}
